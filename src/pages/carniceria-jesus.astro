---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const phone = "+34669575504";
const email = "carniceriajesusnavaluenga@gmail.com";
const facebook = "https://www.facebook.com/share/18qtEyNpws/?mibextid=wwXIfr";
const instagram = "https://www.instagram.com/carniceriajesus_navaluenga/";
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Calle Corredera, 55, Navaluenga, Ávila, España")}`;
---

<Layout title="Carnicería Jesús · Navaluenga" description="Carnicería Jesús. Especialidad en ternera avileña negra ibérica, cordero, cabrito y cochinillo. Calle Corredera, 55, Navaluenga, Ávila." themeColor="#bd0015">
  <main class="page">
    <article class="card">
      <header class="hero">
        <div class="hero-copy">
          <span class="location">NAVALUENGA · ÁVILA</span>
          <img class="logo" src="/companies/carniceria-jesus/logo-transparent.png" alt="Logotipo de Carnicería Jesús" width="2172" height="724" />
          <p class="promise">Garantía de Calidad Natural</p>
        </div>
      </header>

      <div class="body">
        <div class="intro">
          <span class="">CALIDAD QUE SE NOTA</span>
          <h1>Carnicería Jesús</h1>
          <p>Especialidad en ternera avileña negra ibérica, cordero, cabrito y cochinillo.</p>
        </div>

        <section class="quality" aria-label="Sellos de calidad de Carnicería Jesús">
          <img src="/companies/carniceria-jesus/raza-autoctona.png" alt="Raza Autóctona 100 %, Avileña Negra Ibérica" width="424" height="532" loading="lazy" />
          <img src="/companies/carniceria-jesus/tierra-de-sabor.png" alt="Tierra de Sabor, Castilla y León" width="446" height="498" loading="lazy" />
          <img src="/companies/carniceria-jesus/igp.png" alt="Indicación Geográfica Protegida" width="494" height="481" loading="lazy" />
          <img src="/companies/carniceria-jesus/carne-de-avila.png" alt="Indicación Geográfica Protegida Carne de Ávila" width="505" height="495" loading="lazy" />
        </section>

        <section class="social" aria-labelledby="social-title">
          <h2 id="social-title">Síguenos en redes</h2>
          <div class="social-links">
            <a class="social-button facebook" href={facebook} target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={28} /><span>Facebook</span></a>
            <a class="social-button instagram" href={instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={28} /><span>Instagram</span></a>
          </div>
        </section>

        <div class="information">
          <section class="block" aria-labelledby="telefonos">
            <h2 id="telefonos">Hablemos</h2>
            <div class="phones">
              <a href="tel:+34920286389"><span>Teléfono fijo</span><strong>920 286 389</strong></a>
              <a href="tel:+34669575504"><span>Móvil principal</span><strong>669 575 504</strong></a>
              <a href="tel:+34620417833"><span>Otro móvil</span><strong>620 417 833</strong></a>
            </div>
            <a class="email" href={`mailto:${email}`}>{email}</a>
          </section>

          <section class="block visit" aria-labelledby="visitanos">
            <h2 id="visitanos">Visítanos</h2>
            <address>C/ Corredera, 55<br />Navaluenga (Ávila)</address>
            <a class="map-link" href={directions} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
          </section>
        </div>

        <nav class="actions" aria-label="Acciones de contacto">
          <a class="action whatsapp" href={`https://wa.me/${phone.replace(/\D/g, "")}`} target="_blank" rel="noopener noreferrer">WhatsApp <img class="action-image" src="/companies/carniceria-jesus/action-whatsapp.png" width="32" height="32" alt="" aria-hidden="true" /></a>
          <a class="action call" href={`tel:${phone}`}>Llamar <img class="action-image" src="/companies/carniceria-jesus/action-phone.png" width="32" height="32" alt="" aria-hidden="true" /></a>
          <a class="action save" href="/carniceria-jesus.vcf" download="carniceria-jesus.vcf">Guardar contacto <img class="action-image" src="/companies/carniceria-jesus/action-contact.png" width="32" height="32" alt="" aria-hidden="true" /></a>
        </nav>
      </div>
    </article>
  </main>
</Layout>

<style>
  .page{min-height:100svh;display:grid;place-items:center;padding:clamp(16px,4vw,54px);background:#f5f2ed;color:#171717}
  .card{width:min(100%,980px);overflow:hidden;border-radius:26px;background:#fff;box-shadow:0 28px 90px #231b1940}
  .hero{display:flex;align-items:center;min-height:315px;background:#f7f7f5 url('/companies/carniceria-jesus/hero-integrado.png') center center/cover no-repeat}
  .hero-copy{display:flex;width:57%;flex-direction:column;justify-content:center;align-items:center;gap:18px;padding:32px 36px}
  .location{align-self:flex-start;font:800 11px/1.2 Arial,sans-serif;letter-spacing:.17em;color:#bd0015}
  .logo{display:block;width:min(100%,560px);height:auto}
  .promise{margin:0;color:#aa0014;font:italic clamp(20px,3.1vw,30px)/1.2 Georgia,serif;text-align:center}
  .body{padding:clamp(28px,5vw,54px)}
  .intro{border-bottom:1px solid #e4dfd9;padding-bottom:25px}.overline{font:800 11px/1.2 Arial,sans-serif;letter-spacing:.18em;color:#b70017}h1{margin:10px 0 9px;font:700 clamp(34px,5vw,52px)/1.05 Georgia,serif;letter-spacing:-.035em}.intro p{margin:0;max-width:710px;font:18px/1.45 Georgia,serif;color:#45423e}
  .quality{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;justify-items:center;gap:clamp(14px,3vw,36px);padding:27px 12px;border-bottom:1px solid #e4dfd9}.quality img{display:block;width:auto;max-width:100%;height:clamp(85px,11vw,130px);object-fit:contain}
  .information{display:grid;grid-template-columns:1.5fr 1fr;gap:35px;padding:28px 0}h2{margin:0 0 18px;font:700 23px/1.2 Georgia,serif}.phones{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.phones a{display:grid;gap:6px;padding:14px;border-radius:12px;background:#f8f6f2;text-decoration:none;color:#151515}.phones a:hover{background:#f2ece4}.phones span{color:#726b66;font:700 11px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.05em}.phones strong{font:700 clamp(14px,1.7vw,18px)/1.2 Arial,sans-serif;white-space:nowrap}.email{display:inline-block;margin-top:16px;color:#a30017;font:700 15px/1.4 Arial,sans-serif;overflow-wrap:anywhere}.visit{padding-left:30px;border-left:1px solid #e4dfd9}.visit address{font:19px/1.45 Georgia,serif}.map-link{display:inline-flex;gap:8px;margin-top:17px;color:#00613e;font:800 14px/1.3 Arial,sans-serif;text-decoration:none}.map-link:hover,.email:hover{text-decoration:underline}
  .actions{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.action{min-height:54px;display:flex;justify-content:space-between;align-items:center;gap:8px;padding:12px 16px;border-radius:11px;text-decoration:none;color:#fff;font:800 15px/1.2 Arial,sans-serif;transition:transform .18s,box-shadow .18s}.action:hover{transform:translateY(-2px);box-shadow:0 8px 20px #15151525}.action-image{display:block;flex:none;width:32px;height:32px;object-fit:contain;filter:brightness(0) invert(1)}.whatsapp{background:#087644}.call{background:#b70017}.save{background:#141414}.social{padding:26px 0;border-bottom:1px solid #e4dfd9}.social h2{margin-bottom:14px}.social-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.social-button{display:flex;align-items:center;justify-content:center;gap:12px;min-height:62px;padding:14px 12px;border-radius:12px;color:#fff;text-decoration:none;font:800 16px/1.2 Arial,sans-serif;box-shadow:0 5px 15px #15151515;transition:transform .18s,box-shadow .18s}.social-button:hover{transform:translateY(-2px);box-shadow:0 8px 20px #15151525}.social-button :global(svg){flex:none}.facebook{background:#0866d9}.instagram{background:linear-gradient(120deg,#7035b3,#af2467 65%,#b33d32)}
  @media(max-width:700px){.page{display:block;padding:0;background:#fff}.card{border-radius:0;box-shadow:none}.hero{min-height:210px;background-position:54% center}.hero-copy{width:67%;gap:11px;padding:23px 14px}.location{font-size:9px}.promise{font-size:18px}.body{padding:27px 20px}.quality{gap:9px;padding:22px 0}.quality img{height:clamp(66px,19vw,92px)}.information{grid-template-columns:1fr;gap:22px}.visit{border-left:0;border-top:1px solid #e4dfd9;padding:20px 0 0}.phones{grid-template-columns:1fr 1fr}.phones a:first-child{grid-column:span 2}.actions{grid-template-columns:1fr 1fr}.save{grid-column:span 2}}
  @media(max-width:380px){.hero{background-position:56% center}.hero-copy{width:70%}.phones{grid-template-columns:1fr}.phones a:first-child{grid-column:auto}.actions{grid-template-columns:1fr}.save{grid-column:auto}}
</style>
