---
import Layout from "../layouts/Layout.astro";

const mobile = "+34609519424";
const landline = "+34920286035";
const address = "Plaza de España, 12, Navaluenga, Ávila, España";
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<Layout title="Carnicería Salchichería Paco · Navaluenga" description="Carnicería Salchichería Paco. Especialidad en ternera y cordero. Plaza de España, 12, Navaluenga, Ávila." themeColor="#d90012">
  <main class="page">
    <article class="card">
      <div class="hero">
        <span class="hero-label">NAVALUENGA · ÁVILA</span>
        <div class="logo-wrap"><img src="/companies/carniceria-paco/logo.svg" alt="Carnicería Salchichería Paco. Especialidad en ternera y cordero" width="800" height="800" /></div>
      </div>
      <div class="content">
        <p class="eyebrow">CARNICERÍA · SALCHICHERÍA</p>
        <h1>Paco</h1>
        <p class="specialty">Especialidad en ternera y cordero</p>
        <div class="divider"></div>
        <section aria-label="Datos de contacto" class="details">
          <div class="detail"><span class="detail-icon" aria-hidden="true">☎</span><div><span class="label">Teléfono fijo</span><a href={`tel:${landline}`}>920 286 035</a></div></div>
          <div class="detail"><span class="detail-icon" aria-hidden="true">▣</span><div><span class="label">Móvil · WhatsApp</span><a href={`tel:${mobile}`}>609 51 94 24</a></div></div>
          <div class="detail"><span class="detail-icon" aria-hidden="true">⌖</span><div><span class="label">Encuéntranos</span><address>Plaza de España, 12<br />Navaluenga · Ávila</address></div></div>
        </section>
        <nav class="actions" aria-label="Acciones de contacto">
          <a class="action whatsapp" href={`https://wa.me/${mobile.replace(/\D/g, "")}`} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
          <a class="action call" href={`tel:${mobile}`}>Llamar <span aria-hidden="true">↗</span></a>
          <a class="action save" href="/carniceria-paco.vcf" download="carniceria-paco.vcf">Guardar contacto <span aria-hidden="true">↓</span></a>
          <a class="action directions" href={directions} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </article>
  </main>
</Layout>

<style>
  .page{min-height:100svh;display:grid;place-items:center;padding:clamp(18px,5vw,56px);background:radial-gradient(circle at 8% 12%,#ffe4e4,transparent 35%),#f8f6f3;color:#10275e}
  .card{width:min(100%,920px);display:grid;grid-template-columns:41% 59%;overflow:hidden;border-radius:28px;background:white;box-shadow:0 24px 80px #11225020}
  .hero{min-height:650px;position:relative;display:grid;place-items:center;padding:28px;background:linear-gradient(145deg,#ed0016 0%,#c90012 68%,#a90012 100%)}
  .hero:after{content:"";position:absolute;inset:auto -1px 0 0;height:22%;background:#092b79;clip-path:polygon(0 100%,100% 100%,100% 0)}
  .hero-label{position:absolute;top:35px;left:34px;color:white;font-size:11px;font-weight:800;letter-spacing:.18em}
  .logo-wrap{position:relative;z-index:1;width:min(90%,310px);aspect-ratio:1;border-radius:32px;overflow:hidden;background:white;box-shadow:0 18px 40px #49000955;transform:rotate(-3deg)}
  .logo-wrap img{width:100%;height:100%;object-fit:cover}
  .content{padding:clamp(32px,6vw,62px);display:flex;flex-direction:column;justify-content:center}
  .eyebrow{margin:0;color:#df0018;font-size:11px;font-weight:850;letter-spacing:.16em}
  h1{font-size:clamp(64px,9vw,100px);line-height:1;margin:9px 0 5px;color:#e00015;font-family:Georgia,serif;font-weight:900;letter-spacing:-.06em}
  .specialty{font-size:clamp(16px,2vw,20px);font-weight:700;line-height:1.25;margin:0;color:#092b79}
  .divider{height:2px;width:48px;background:#e00015;margin:30px 0}
  .details{display:grid;gap:20px}.detail{display:flex;gap:16px;align-items:flex-start}.detail-icon{width:40px;height:40px;flex:none;border-radius:12px;display:grid;place-items:center;background:#fce8e9;color:#d90012;font-size:23px;font-weight:700}.detail div{display:grid;gap:3px}.label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:800;color:#68738c}.detail a,.detail address{font-size:17px;font-style:normal;font-weight:700;line-height:1.4;color:#10275e;text-decoration:none}.detail a:hover{text-decoration:underline}
  .actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:34px}.action{display:flex;justify-content:space-between;align-items:center;gap:6px;min-height:52px;padding:10px 14px;border-radius:12px;text-decoration:none;font-size:14px;font-weight:800;transition:transform .18s,box-shadow .18s}.action:hover{transform:translateY(-2px);box-shadow:0 7px 18px #10275e20}.action span{font-size:20px}.whatsapp{background:#16834b;color:#fff}.call{background:#092b79;color:#fff}.save{background:#e00015;color:#fff}.directions{background:#edf2fa;color:#092b79}
  @media(max-width:700px){.page{padding:0;background:white;display:block}.card{display:block;border-radius:0;box-shadow:none}.hero{min-height:260px;padding:45px 20px 20px}.hero-label{top:20px;left:20px}.logo-wrap{width:170px;border-radius:20px}.content{padding:32px 24px 40px}h1{font-size:72px}.divider{margin:25px 0}.actions{margin-top:28px}}
  @media(max-width:360px){.actions{grid-template-columns:1fr}.action{min-height:48px}}
</style>
