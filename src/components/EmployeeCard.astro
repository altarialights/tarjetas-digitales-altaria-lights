---
import type { Employee } from "../data/employees";
import { clean } from "../lib/employees";
import BackgroundPattern from "./BackgroundPattern.astro";
import ContactActions from "./ContactActions.astro";
import ContactInfo from "./ContactInfo.astro";
import Icon from "./Icon.astro";
import ProfilePhoto from "./ProfilePhoto.astro";

interface Props {
  employee: Employee;
}

const { employee } = Astro.props;
const department = clean(employee.department);

// El nombre se parte en nombre / apellidos para controlar el salto de línea,
// salvo que fullName no coincida con ambos (p. ej. un nombre compuesto especial).
const first = employee.firstName.trim();
const last = employee.lastName.trim();
const splitName = employee.fullName.trim() === `${first} ${last}`;
const brand = employee.brand;
const brandVars = brand
  ? `--color-brand:${brand.color};--color-brand-600:${brand.dark};--color-brand-ink:${brand.ink};--color-brand-50:${brand.tintSoft};--color-brand-100:${brand.tint};--color-brand-highlight:${brand.highlight};--brand-shadow-rgb:${brand.shadow}`
  : undefined;

/* ------------------------------------------------------------------ */
/*  Masa naranja: la curva en S de la tarjeta física, en un viewBox    */
/*  100×100 que se estira con el contenedor. Una única definición      */
/*  alimenta la máscara (relleno) y las líneas de eco.                 */
/* ------------------------------------------------------------------ */
const edge = {
  mobile: "C 90 57 81 62 72 72 C 60 86 42 93 0 90",
  desktop: "C 97 17 100 34 93.5 50 C 87 66 80 81 87 100",
};
const mass = {
  mobile: `M0 0 H100 V60 ${edge.mobile} Z`,
  desktop: `M0 0 H84 ${edge.desktop} H0 Z`,
};
const line = {
  mobile: `M100 60 ${edge.mobile}`,
  desktop: `M84 0 ${edge.desktop}`,
};

const svgMask = (d: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='${d}'/></svg>`,
  )}")`;

const massVars = `--mask-m:${svgMask(mass.mobile)};--mask-d:${svgMask(mass.desktop)}`;
---

<main class="card" style={brandVars}>
  <BackgroundPattern />

  <header class="hero">
    <div class="mass" style={massVars} aria-hidden="true"></div>

    <svg class="echo echo-m" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d={line.mobile} transform="translate(0 5)" />
      <path d={line.mobile} transform="translate(0 10)" />
    </svg>
    <svg class="echo echo-d" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d={line.desktop} transform="translate(3 0)" />
      <path d={line.desktop} transform="translate(6 0)" />
    </svg>

    <div class="brand">
      <div class:list={["logo-badge", "reveal", { "logo-badge--dark": employee.logoOnDark }]} style="--reveal: drop; --d: 60ms">
        <img
          class="logo"
          src={employee.companyLogo}
          alt={employee.company}
          width="800"
          height="200"
          decoding="async"
        />
      </div>
      <p class="chip reveal" style="--d: 520ms">
        <Icon name="nfc" size={16} />
        <span>
          Tarjeta digital creada por
          <a
            class="creator-link"
            href="https://altarialights.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar la web de Altaria Lights (se abre en una nueva pestaña)"
          >
            Altaria Lights<span class="creator-arrow" aria-hidden="true">↗</span>
          </a>
        </span>
      </p>
    </div>

    <div class="photo-slot">
      <ProfilePhoto employee={employee} />
    </div>
  </header>

  <section class="content" aria-labelledby="employee-name">
    <div class="identity">
      <h1 id="employee-name" class="name reveal" style="--d: 260ms">
        {
          splitName ? (
            <>
              <span>{first}</span> <span>{last}</span>
            </>
          ) : (
            employee.fullName.trim()
          )
        }
      </h1>
      <p class="position reveal" style="--d: 340ms">{employee.position.trim()}</p>
      {
        department && (
          <p class="department reveal" style="--d: 400ms">
            <span class="sr-only">Departamento: </span>
            {department}
          </p>
        )
      }
    </div>

    <ContactInfo employee={employee} delay={480} />

    <ContactActions employee={employee} delay={700} />
  </section>
</main>

<style>
  /* ================================================================= */
  /*  MÓVIL (base)                                                      */
  /* ================================================================= */
  .card {
    --gutter: clamp(1.25rem, 5.6vw, 2rem);
    --photo: min(clamp(7.5rem, 22vh, 13rem), 40vw);

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow: clip;
  }

  /* svh stays fixed while Safari's browser bars collapse during scrolling. */
  @supports (height: 100svh) {
    .card {
      min-height: 100svh;
      --photo: min(clamp(7.5rem, 22svh, 13rem), 40vw);
    }
  }

  /* ---------- Cabecera naranja ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding: calc(env(safe-area-inset-top, 0px) + clamp(1.125rem, 3.2vh, 2rem)) var(--gutter) 0;
  }

  .mass {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      repeating-radial-gradient(circle at 0 0, transparent 0 30px, rgb(255 255 255 / 0.075) 30px 31px),
      radial-gradient(130% 110% at 0% 0%, var(--color-brand-highlight) 0%, var(--color-brand) 48%, var(--color-brand-600) 100%);
    -webkit-mask: var(--mask-m) 0 0 / 100% 100% no-repeat;
    mask: var(--mask-m) 0 0 / 100% 100% no-repeat;
    transform-origin: 0 0;
  }

  .echo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: visible;
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 1.25;
    pointer-events: none;
    animation: fade 1.2s ease 0.45s both;
  }

  .echo path {
    vector-effect: non-scaling-stroke;
  }

  .echo path:first-child { opacity: 0.32; }
  .echo path:last-child { opacity: 0.14; }

  @media (hover: none) and (pointer: coarse) {
    .echo {
      animation: none;
    }
  }

  .echo-d { display: none; }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    /* El chip queda por encima del borde curvo */
    padding-bottom: calc(var(--photo) * 0.42);
  }

  /* El logo es naranja: necesita una placa blanca para tener contraste
     sobre la cabecera naranja. */
  .logo-badge {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.55rem 0.9rem;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 10px 24px -12px rgb(var(--brand-shadow-rgb) / 0.55);
  }

  .logo-badge--dark {
    background: #071731;
  }

  .logo {
    display: block;
    height: clamp(1.5rem, 6.8vw, 2rem);
    width: auto;
    max-width: 100%;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    margin: 0;
    padding: 0.4rem 0.75rem 0.4rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    color: var(--color-brand-ink);
    background: #fff;
    box-shadow: 0 6px 16px -8px rgb(var(--brand-shadow-rgb) / 0.5);
  }

  .chip > :global(svg) {
    flex: none;
  }

  .chip > span {
    min-width: 0;
    line-height: 1.25;
    text-wrap: balance;
  }

  .creator-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.18em;
    margin-left: 0.18em;
    color: var(--color-brand-ink);
    font-weight: 800;
    text-decoration: none;
    outline: none;
  }

  .creator-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.12rem;
    left: 0;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transform: scaleX(0.28);
    transform-origin: left;
    opacity: 0.5;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.2s ease;
  }

  .creator-arrow {
    display: inline-block;
    font-size: 0.92em;
    transition: transform 0.3s var(--ease-out-expo);
  }

  .creator-link:hover::after,
  .creator-link:focus-visible::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .creator-link:hover .creator-arrow,
  .creator-link:focus-visible .creator-arrow {
    transform: translate(0.12rem, -0.12rem);
  }

  .creator-link:focus-visible {
    border-radius: 0.25rem;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.72), 0 0 0 5px var(--color-brand-ink);
  }

  .photo-slot {
    margin-top: clamp(1.5rem, 4.5vh, 3rem);
  }

  /* ---------- Contenido ---------- */
  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(1.125rem, 2.8vh, 2rem) var(--gutter) calc(env(safe-area-inset-bottom, 0px) + clamp(1rem, 2.6vh, 1.75rem));
  }

  .identity {
    margin-bottom: clamp(0.875rem, 2.6vh, 1.75rem);
  }

  .name {
    margin: 0;
    font-size: clamp(1.75rem, 7.9vw, 2.375rem);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .name > span {
    display: block;
  }

  .name > span:first-child {
    color: var(--color-brand-ink);
  }

  .position {
    margin: 0.5rem 0 0;
    font-size: clamp(1rem, 4.3vw, 1.125rem);
    font-weight: 520;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .department {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .department::before {
    content: "";
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-brand);
  }

  .content > :global(.actions) {
    margin-top: auto;
    padding-top: clamp(1rem, 2.4vh, 1.75rem);
  }

  /* Móviles bajos (iPhone SE, etc.): se compacta sin reducir la legibilidad */
  @media (max-width: 1023.98px) and (max-height: 700px) {
    .card {
      --photo: min(clamp(7rem, 18.5vh, 9rem), 38vw);
      --cta-h: 3.5rem;
      --btn-h: 2.75rem;
      --actions-gap: 0.625rem;
      --row-min: 3rem;
    }

    @supports (height: 100svh) {
      .card {
        --photo: min(clamp(7rem, 18.5svh, 9rem), 38vw);
      }
    }

    .photo-slot {
      margin-top: 1rem;
    }

    .identity {
      margin-bottom: 0.625rem;
    }

    .content > :global(.actions) {
      padding-top: 0.875rem;
    }
  }

  /* Pantallas muy estrechas (320px): el chip se reduce a su icono */
  @media (max-width: 359.98px) {
    .chip > span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .chip {
      padding: 0.45rem;
    }
  }

  /* ================================================================= */
  /*  TABLET VERTICAL: misma experiencia, columna central más amplia    */
  /* ================================================================= */
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .card {
      --gutter: max(2.5rem, calc((100vw - 34rem) / 2));
      --photo: min(clamp(9rem, 21vh, 15rem), 40vw);
    }

    @supports (height: 100svh) {
      .card {
        --photo: min(clamp(9rem, 21svh, 15rem), 40vw);
      }
    }

    .name {
      font-size: 2.75rem;
    }
  }

  /* ================================================================= */
  /*  ESCRITORIO y TABLET HORIZONTAL: marca a la izquierda, datos a la  */
  /*  derecha. Va al final para prevalecer sobre las reglas anteriores. */
  /* ================================================================= */
  @media (min-width: 1024px), (min-width: 768px) and (orientation: landscape) {
    .card {
      --photo: clamp(12rem, min(44vh, 29vw), 30rem);
      display: grid;
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
    }

    @supports (height: 100svh) {
      .card {
        --photo: clamp(12rem, min(44svh, 29vw), 30rem);
      }
    }

    .hero {
      display: grid;
      place-items: center;
      padding: 0;
    }

    .mass {
      -webkit-mask-image: var(--mask-d);
      mask-image: var(--mask-d);
      background:
        repeating-radial-gradient(circle at 0 0, transparent 0 44px, rgb(255 255 255 / 0.07) 44px 45px),
        radial-gradient(120% 100% at 0% 0%, var(--color-brand-highlight) 0%, var(--color-brand) 50%, var(--color-brand-600) 100%);
    }

    .echo-m { display: none; }
    .echo-d { display: block; }

    .brand {
      position: absolute;
      inset: clamp(2rem, 6vh, 3.5rem) clamp(2rem, 4vw, 4rem);
      padding: 0;
    }

    .logo-badge {
      padding: 0.7rem 1.1rem;
      border-radius: 1.125rem;
    }

    .logo {
      height: clamp(1.75rem, 4.2vh, 2.35rem);
    }

    .chip {
      font-size: 0.8125rem;
      padding: 0.5rem 0.9rem 0.5rem 0.7rem;
      white-space: nowrap;
    }

    .photo-slot {
      margin: 0;
      /* La foto se desplaza hacia la curva, como en la tarjeta física */
      transform: translateX(12%);
    }

    .content {
      justify-content: center;
      justify-self: center;
      width: 100%;
      max-width: 44rem;
      padding: clamp(2rem, 6vh, 4rem) clamp(2.5rem, 6vw, 6rem);
      padding-left: clamp(3rem, 7vw, 7rem);
    }

    .name {
      font-size: clamp(2.5rem, min(3.6vw, 6.6vh), 3.75rem);
    }

    .position {
      margin-top: 0.75rem;
      font-size: clamp(1.0625rem, 1.3vw, 1.3125rem);
    }

    .department {
      margin-top: 0.6rem;
    }

    .identity {
      margin-bottom: clamp(1.25rem, 4vh, 2.5rem);
    }

    .content > :global(.actions) {
      margin-top: 0;
      padding-top: clamp(1.25rem, 4vh, 2.5rem);
      max-width: 30rem;
    }
  }
</style>
